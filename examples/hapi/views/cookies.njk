{% extends "govuk-analytics-consent/template.njk" %}
{% from "govuk-analytics-consent/macro.njk" import govukAnalyticsConsentCookiesPage %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}

{% set assetPath = "/govuk-frontend/assets" %}

{% block pageTitle %}Cookies - Example service{% endblock %}

{% block head %}
  {{ super() }}
  <link rel="stylesheet" href="/govuk-frontend/govuk-frontend.min.css">
{% endblock %}

{% block content %}
  {{ govukAnalyticsConsentCookiesPage(govukAnalyticsConsent) }}
{% endblock %}

{% block footer %}
  {{ govukFooter({
    meta: {
      items: [
        {
          href: "/cookies",
          text: "Cookies"
        }
      ]
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module">
    import { initAll } from '/govuk-frontend/govuk-frontend.min.js'
    initAll()
  </script>
{% endblock %}
